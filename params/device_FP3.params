#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################

# COMMON Block
export HUGO_CI_GUIDE=""
export HUGO_CI_GUIDE_PATH=""
export HUGO_CODENAME="FP3"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"
export HUGO_FIRMWARE="included"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK="fp3"
export HUGO_NAME="Fairphone 3"
export HUGO_VENDOR="Fairphone"
export HUGO_XDALINK="https://xdaforums.com/TBD"

# SLIM Block
export HUGO_SLIM_ANDROID="13"
export HUGO_SLIM_ENCRYPTION="FBEv1"
export HUGO_SLIM_FIRSTRELEASE="2025-04-06"
export HUGO_SLIM_RELOCKABLE="yes"
export HUGO_SLIM_STATE="stable"
export HUGO_SLIM_SUPPORTLEVEL="community"
export HUGO_SLIM_VERIFIEDBOOT="v2.0"
export HUGO_SLIM_FLAVOR=True
