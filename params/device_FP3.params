#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################
export HUGO_VENDOR="Fairphone"
export HUGO_NAME="Fairphone FP3"
export HUGO_CODENAME="FP3"
export HUGO_ANDROID="13"
export HUGO_ENCRYPTION="FBEv1"
export HUGO_FIRMWARE="included"
export HUGO_RELOCKABLE="yes"
export HUGO_VERIFIEDBOOT="yes"
export HUGO_FLAVORS="Slim"
export HUGO_STATE="!! ALPHA !!"
export HUGO_SUPPORTLEVEL="team"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK="fp3"
export HUGO_XDALINK="https://xdaforums.com/TBD"
export HUGO_FIRSTRELEASE="not-released-yet, see [#32](https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues/32)"
