export HUGO_VENDOR="Google"
export HUGO_XDALINK="https://xdaforums.com/t/rom-a13-official-microg-hardened-sunfish-axp-os-20.4651368/"

# PRO Block
export HUGO_PRO_ANDROID="15"
export HUGO_PRO_FLAVOR=Trueexport HUGO_PRO_ENCRYPTION="FBEv1"
export HUGO_PRO_FIRSTRELEASE="2024-01-16 (A13)<br/>2026-02-10 (A15)"
