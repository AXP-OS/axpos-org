#!/bin/bash
###############################################################################
# device specs for sunfish
###############################################################################

# COMMON Block
export HUGO_CI_GUIDE=""
export HUGO_CI_GUIDE_PATH=""
export HUGO_CODENAME="sunfish"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="yes"
export HUGO_FIRMWARE="included"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="yes"
export HUGO_KILINK=""
export HUGO_NAME="Google Pixel 4a"
export HUGO_VENDOR="Google"
export HUGO_XDALINK="https://xdaforums.com/t/rom-a13-official-microg-hardened-sunfish-axp-os-20.4651368/"

# PRO Block
export HUGO_PRO_ANDROID="13"
export HUGO_PRO_ENCRYPTION="FBEv1"
export HUGO_PRO_FIRSTRELEASE="2024-01-16"
export HUGO_PRO_FLAVOR=True
export HUGO_PRO_RELOCKABLE="yes"
export HUGO_PRO_STATE="stable"
export HUGO_PRO_SUPPORTLEVEL="team"
export HUGO_PRO_VERIFIEDBOOT=v2.0

# SLIM Block
export HUGO_SLIM_ANDROID="13"
export HUGO_SLIM_ENCRYPTION="FBEv1"
export HUGO_SLIM_FIRSTRELEASE="2025-02-05"
export HUGO_SLIM_FLAVOR=True
export HUGO_SLIM_RELOCKABLE="yes"
export HUGO_SLIM_STATE="stable"
export HUGO_SLIM_SUPPORTLEVEL="community"
export HUGO_SLIM_VERIFIEDBOOT=v2.0