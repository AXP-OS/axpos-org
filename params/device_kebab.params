#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################

# COMMON Block
export HUGO_CI_GUIDE=""
export HUGO_CI_GUIDE_PATH=""
export HUGO_CODENAME="kebab"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"
export HUGO_FIRMWARE="manual"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK=""
export HUGO_NAME="OnePlus 8T"
export HUGO_VENDOR="OnePlus"
export HUGO_XDALINK=""

# PRO Block
export HUGO_PRO_ANDROID="13"
export HUGO_PRO_ENCRYPTION="FBEv2"
export HUGO_PRO_FIRSTRELEASE="[WIP](https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues/26)"
export HUGO_PRO_RELOCKABLE="no"
export HUGO_PRO_STATE="!! ALPHA !!"
export HUGO_PRO_SUPPORTLEVEL="community"
export HUGO_PRO_VERIFIEDBOOT="v2.0"
export HUGO_PRO_FLAVOR=True
