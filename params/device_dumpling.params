#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################
export HUGO_VENDOR="OnePlus"
export HUGO_NAME="OnePlus 5T"
export HUGO_CODENAME="dumpling"
export HUGO_ANDROID="13"

# see device fstab or if not defined the common one
# ICE, FBEv1, FBEv2
export HUGO_ENCRYPTION="ICE"

# see vendor_firmware
export HUGO_FIRMWARE="included"

export HUGO_RELOCKABLE="no" # reported to not work, requires testers for enabling
export HUGO_VERIFIEDBOOT="yes"

# Slim, Pro
export HUGO_FLAVORS="Pro"

# !! ALPHA !!, BETA, stable
export HUGO_STATE="stable"

export HUGO_SUPPORTLEVEL="community"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"

# A/B device or not?
export HUGO_ISAB="no"

export HUGO_ISPIXEL="no"

# known issues topic title, e.g: "cheeseburgerdumpling" (no hash!) in case of:
# https://axpos.org/docs/knowledge/knownissues/#cheeseburgerdumpling
export HUGO_KILINK="cheeseburgerdumpling"

export HUGO_XDALINK="N/A"
export HUGO_FIRSTRELEASE="2025-08-05"
