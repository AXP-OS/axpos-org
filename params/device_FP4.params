#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################
export HUGO_VENDOR="Fairphone"
export HUGO_NAME="Fairphone 4"
export HUGO_CODENAME="FP4"
export HUGO_ANDROID="13"
export HUGO_ENCRYPTION="FBEv2"
export HUGO_FIRMWARE="included"
export HUGO_RELOCKABLE="yes"
export HUGO_VERIFIEDBOOT="yes"
export HUGO_FLAVORS="Slim"
