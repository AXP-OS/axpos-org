export HUGO_DEBUGBOOTPATH="/metadata"
export HUGO_FACTORYZIP="no"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK="fp4"
export HUGO_XDALINK="https://xdaforums.com/TBD"
export HUGO_FIRSTRELEASE="not released yet, see [#40](https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues/40)"
