#!/bin/bash
###############################################################################
# device specs for blueline
###############################################################################

# COMMON Block
export HUGO_CI_GUIDE=""
export HUGO_CI_GUIDE_PATH=""
export HUGO_CODENAME="blueline"
export HUGO_DEBUGBOOTPATH="/metadata"
export HUGO_FACTORYZIP="yes"
export HUGO_FIRMWARE="included"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="yes"
export HUGO_KILINK=""
export HUGO_NAME="Google Pixel 3"
export HUGO_VENDOR="Google"
export HUGO_XDALINK="TBD"
export HUGO_TRACKER="https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues?q=&type=all&state=all&labels=63"

# PRO Block
export HUGO_PRO_ANDROID="15"
export HUGO_PRO_FLAVOR=True
export HUGO_PRO_ENCRYPTION="ICE"
export HUGO_PRO_FIRSTRELEASE="WIP"
export HUGO_PRO_RELOCKABLE="yes"
export HUGO_PRO_PATCHLEVEL="Platform + Kernel"
export HUGO_PRO_STATE="!! ALPHA !!"
export HUGO_PRO_SUPPORTLEVEL="community"
export HUGO_PRO_VERIFIEDBOOT="v2.0"

# SLIM Block
export HUGO_SLIM_ANDROID="15"
export HUGO_SLIM_FLAVOR=True
export HUGO_SLIM_ENCRYPTION="ICE"
export HUGO_SLIM_FIRSTRELEASE="TBD"
export HUGO_SLIM_RELOCKABLE="yes"
export HUGO_SLIM_PATCHLEVEL="Platform + Kernel"
export HUGO_SLIM_STATE="!! ALPHA !!"
export HUGO_SLIM_SUPPORTLEVEL="community"
export HUGO_SLIM_VERIFIEDBOOT="v2.0"
