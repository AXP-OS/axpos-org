export HUGO_XDALINK=""


# SLIM Block
export HUGO_SLIM_ANDROID="15"
export HUGO_SLIM_FLAVOR=True
export HUGO_SLIM_ENCRYPTION="ICE"
export HUGO_SLIM_FIRSTRELEASE="2026-02-10"
