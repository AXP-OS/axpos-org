#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################
export HUGO_VENDOR="Sony"
export HUGO_NAME="Sony Xperia 10"
export HUGO_CODENAME="kirin"
export HUGO_ANDROID="13"
export HUGO_ENCRYPTION="ICE"
export HUGO_FIRMWARE="manual"
export HUGO_RELOCKABLE="no"
export HUGO_VERIFIEDBOOT="v2.0"
export HUGO_FLAVORS="Slim"
export HUGO_STATE="!! ALPHA !!"
export HUGO_SUPPORTLEVEL="community"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK=
export HUGO_XDALINK=
export HUGO_FIRSTRELEASE="_[IN-PROGRESS](https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues/34)_"
