#!/bin/bash
###############################################################################
# device specs for creating a new page
###############################################################################

# COMMON Block
export HUGO_CI_GUIDE=""
export HUGO_CI_GUIDE_PATH=""
export HUGO_CODENAME="kirin"
export HUGO_DEBUGBOOTPATH="/mnt/vendor/persist"
export HUGO_FACTORYZIP="no"
export HUGO_FIRMWARE="manual"
export HUGO_ISAB="yes"
export HUGO_ISPIXEL="no"
export HUGO_KILINK=""
export HUGO_NAME="Sony Xperia 10"
export HUGO_VENDOR="Sony"
export HUGO_XDALINK=""

# SLIM Block
export HUGO_SLIM_ANDROID="13"
export HUGO_SLIM_ENCRYPTION="ICE"
export HUGO_SLIM_FIRSTRELEASE="_[WIP](https://code.binbash.rocks/AXP.OS-public/issue-tracker/issues/34)_"
export HUGO_SLIM_RELOCKABLE="no"
export HUGO_SLIM_STATE="!! ALPHA !!"
export HUGO_SLIM_SUPPORTLEVEL="community"
export HUGO_SLIM_VERIFIEDBOOT="v2.0"
export HUGO_SLIM_FLAVOR=True
